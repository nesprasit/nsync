{
  "name": "nsync",
  "version": "0.1.0",
  "description": "NSync — sync an Obsidian vault across devices via Google Drive appDataFolder.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "keywords": [
    "obsidian",
    "sync",
    "google-drive"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.24.0",
    "obsidian": "latest",
    "tslib": "^2.7.0",
    "tsx": "^4.23.13",
    "typescript": "^5.6.0"
  }
}
